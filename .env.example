# ==============================================================================
# Vertexia Retail POS — MongoDB Atlas Cloud API & Sync Configuration
# ==============================================================================
# Copy this file to .env and fill real values before running the Cloud API.

# MongoDB Atlas Connection String (Server-Side ONLY! Never expose to browser/PWA)
# Atlas M0 Free Forever example:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://mrtaha09876_db_user:Larkana222@vertexiaretail.h82bjqf.mongodb.net/
MONGODB_DB_NAME=vertexia_cloud
MONGODB_MAX_POOL_SIZE=20

# Cloud API Server (Platform-independent: binds 0.0.0.0:$PORT in production)
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8090
# Strict allowlist of Remote Owner PWA origins (NO wildcard * in production)
CLOUD_CORS_ORIGINS=https://owner.yourdomain.com,http://localhost:5174
CLOUD_TLS_CERT=
CLOUD_TLS_KEY=

# Security Secrets (MINIMUM 32 RANDOM CHARACTERS IN PRODUCTION!)
CLOUD_JWT_SECRET=replace-with-random-64-hex-char-cloud-jwt-secret-value
CLOUD_NODE_HMAC_SECRET=replace-with-random-64-hex-char-node-hmac-secret-value

# Cloud Backup Retention Metadata
CLOUD_BACKUP_RETENTION_DAILY=7
CLOUD_BACKUP_RETENTION_WEEKLY=4

# Remote Owner PWA Build-Time Variables (Non-secret public Cloud API URL)
VITE_CLOUD_API_URL=https://your-cloud-api.onrender.com
# Optional: set true only if hosting on always-on server with persistent WebSockets
VITE_CLOUD_REALTIME_WS=false

# Shop Main PC Sync Client Configuration (Windows User Env Variables on Main PC)
VERTEXIA_CLOUD_URL=
VERTEXIA_SYNC_INTERVAL_MS=10000
VERTEXIA_LAN_TLS_CERT=
VERTEXIA_LAN_TLS_KEY=

# Optional Licensing Endpoint Override
VERTEXIA_LICENSE_SERVER_URL=
