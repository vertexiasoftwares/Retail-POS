# ==============================================================================
# Vertexia Retail POS — Cloud Gateway & Sync Environment Configuration
# ==============================================================================
# Copy this file to .env and fill real values before running the Cloud Gateway.

# Supabase / Managed PostgreSQL Connection (Single-Cluster Schema Multi-Tenancy)
# Use Supabase Supavisor Session Pooler (IPv4 + TLS) for broad Windows/LAN compatibility:
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_CENTRAL_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Optional direct migration URI (falls back to DATABASE_CENTRAL_URL when omitted)
PG_DIRECT_URL=
# Optional TLS verification mode: disable | require | verify-full (auto-detected from host)
PG_SSL_MODE=
# Single shared pg.Pool max connections (default 20)
PG_POOL_MAX=20

# Cloud Gateway Server
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8090
CLOUD_CORS_ORIGINS=https://owner.vertexia.example,http://localhost:5173
CLOUD_TLS_CERT=
CLOUD_TLS_KEY=

# Security Secrets (MINIMUM 32 CHARACTERS IN PRODUCTION!)
CLOUD_JWT_SECRET=replace-with-random-64-hex-char-cloud-jwt-secret-value
CLOUD_NODE_HMAC_SECRET=replace-with-random-64-hex-char-node-hmac-secret-value

# Cloud Backup Directory & Retention
PG_BACKUP_DIR=./backups/cloud
PG_BACKUP_RETENTION_DAILY=7
PG_BACKUP_RETENTION_WEEKLY=4

# Shop Main PC Sync Client Configuration (Desktop Main PC Only)
VERTEXIA_CLOUD_URL=
VERTEXIA_SYNC_INTERVAL_MS=10000
VERTEXIA_LAN_TLS_CERT=
VERTEXIA_LAN_TLS_KEY=

# Optional Licensing Endpoint Override (defaults to MedKit/Vertexia licensing authority)
VERTEXIA_LICENSE_SERVER_URL=
